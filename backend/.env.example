# 复制为 .env 后按本地环境修改；.env 已在 .gitignore 中忽略，不提交。
# MySQL（本地实例；库名建议 risk_control，测试库 risk_control_test）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=risk_control
DB_ECHO=false

# Redis（特征滑动窗口 / 幂等 / 广播 / 计数）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 鉴权
JWT_SECRET=请替换为随机字符串（至少 32 字节；HS256 的密钥短于 256 bit 时 PyJWT 会告警）
JWT_EXPIRE_DAYS=7
API_KEY_SEED=演示用业务端密钥（首次初始化时写入 sys_api_key）

# 运行
LOG_LEVEL=INFO
FEATURE_WINDOW_PROFILE=default     # default = 1h/24h/7d 三档
APP_ENV=dev
